{
  "name": "SYSTEM: MONARCH CALISTHENICS",
  "short_name": "Monarch",
  "description": "Solo Leveling inspired calisthenics game engine with real-time AI computer vision form tracking, adaptive daily quests, and offline hunter HUD.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#08090d",
  "theme_color": "#08090d",
  "categories": ["fitness", "games", "health", "sports"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/monarch-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Vision Workout",
      "short_name": "Workout",
      "description": "Open AI Computer Vision Workout Tracker",
      "url": "/?mode=workout",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Daily Quest Log",
      "short_name": "Quests",
      "description": "Review Hunter Daily Objectives",
      "url": "/?mode=quests",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}